{
  "uid": "devops-assistant",
  "title": "DevOps Assistant",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Générations",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "targets": [ { "refId": "A", "queryType": "instant",
        "expr": "sum(count_over_time({service=\"api\"} | json | event=\"generate\" [$__range]))" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Avertissements détectés",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "targets": [ { "refId": "A", "queryType": "instant",
        "expr": "sum(sum_over_time({service=\"api\"} | json | event=\"generate\" | unwrap warnings [$__range]))" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Durée moyenne (s)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "s", "decimals": 1 } },
      "targets": [ { "refId": "A", "queryType": "instant",
        "expr": "avg(avg_over_time({service=\"api\"} | json | event=\"generate\" | unwrap duration_s [$__range]))" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Erreurs Ollama",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "targets": [ { "refId": "A", "queryType": "instant",
        "expr": "sum(count_over_time({service=\"api\"} | json | event=\"ollama_error\" [$__range]))" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Générations par type",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "queryType": "range", "legendFormat": "{{kind}}",
        "expr": "sum by (kind) (count_over_time({service=\"api\"} | json | event=\"generate\" [1m]))" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Durée moyenne par type (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "refId": "A", "queryType": "range", "legendFormat": "{{kind}}",
        "expr": "avg by (kind) (avg_over_time({service=\"api\"} | json | event=\"generate\" | unwrap duration_s [5m]))" } ]
    },
    {
      "id": 7, "type": "logs", "title": "Logs des générations",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "queryType": "range",
        "expr": "{service=\"api\"} | json | event=\"generate\"" } ]
    }
  ]
}
